{
  "name": "meme-as-a-service",
  "version": "2.1.0",
  "description": "A node library + CLI + REST API that generates memes dynamically for Slack/Discord bots using templates",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "meme-as-a-service": "dist/cli.js"
  },
  "files": [
    "dist/",
    "templates/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/api/index.js",
    "cli": "node dist/cli.js",
    "api": "node dist/api/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "setup": "node scripts/download-templates.js",
    "setup-real": "node scripts/download-real-templates.js",
    "add-templates": "node scripts/add-more-templates.js",
    "template-wizard": "node scripts/template-wizard.js",
    "coordinate-helper": "node scripts/coordinate-helper.js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "meme",
    "generator",
    "slack",
    "discord",
    "bot",
    "cli",
    "api",
    "templates",
    "openapi",
    "swagger",
    "image-generation"
  ],
  "author": "Ankit Sharma <ankit.sharma199803@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "axios": "^1.7.7",
    "close-with-grace": "^2.5.0",
    "commander": "^12.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "fs-extra": "^11.2.0",
    "helmet": "^8.0.0",
    "jszip": "^3.10.1",
    "lru-cache": "^11.3.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.33.5",
    "swagger-ui-dist": "^5.32.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.13",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-dist": "^3.30.6",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beingmartinbmc/meme-as-a-service.git"
  },
  "bugs": {
    "url": "https://github.com/beingmartinbmc/meme-as-a-service/issues"
  },
  "homepage": "https://github.com/beingmartinbmc/meme-as-a-service#readme"
}
